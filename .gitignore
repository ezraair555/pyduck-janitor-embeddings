# Build artifacts
dist/
build/
*.egg-info/

# Python
__pycache__/
*.py[cod]
*.so

# Bundled model weights are populated by scripts/fetch_models.py at build
# time. Keep them out of git so the repo stays small. The NOTICE +
# LICENSE files are also generated, but those are small text and tracked.
src/pyduck_janitor_embeddings/data/
src/pyduck_janitor_embeddings/data/embeddings/*/model.safetensors
src/pyduck_janitor_embeddings/data/embeddings/*/pytorch_model.bin
src/pyduck_janitor_embeddings/data/embeddings/*/tf_model.h5
src/pyduck_janitor_embeddings/data/embeddings/*/flax_model.msgpack
src/pyduck_janitor_embeddings/data/embeddings/*/tokenizer.json
src/pyduck_janitor_embeddings/data/embeddings/*/vocab.txt
src/pyduck_janitor_embeddings/data/embeddings/*/merges.txt
src/pyduck_janitor_embeddings/data/embeddings/*/special_tokens_map.json
# Generated license trail (created by fetch_models.py; safe to commit if
# you want — they're plain text. Keep them excluded so fetch_models.py
# is the single source of truth).
src/pyduck_janitor_embeddings/data/embeddings/*/NOTICE
src/pyduck_janitor_embeddings/data/embeddings/*/LICENSE
src/pyduck_janitor_embeddings/data/embeddings/*/config.json
